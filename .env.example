# Public Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only elevated key. Avoid using unless a specific server task requires it.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (server only)
R2_ACCOUNT_ID=
R2_BUCKET_NAME=hbi-videos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional AI
HBI_AI_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SESEN

# Optional shared video. Leave unset to keep all video local.
R2_MAX_SHARED_BYTES=1073741824
