{
  "name": "hbi-handball-intelligence",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "next dev",
    "dev:cf": "vite dev",
    "build": "next build",
    "build:cf": "vite build",
    "preview:cf": "vite preview",
    "deploy:cf": "wrangler deploy",
    "vinext:init": "vinext init --platform=cloudflare --legacy-wrangler-cloudflare-init",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > lib/supabase/database.types.ts",
    "db:test": "supabase test db",
    "db:verify": "node scripts/verify-db.mjs",
    "package:verify": "python scripts/verify-package.py"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@hookform/resolvers": "^5.0.0",
    "@react-pdf/renderer": "^4.0.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.0.0",
    "dexie": "^4.0.0",
    "dexie-react-hooks": "^4.0.0",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.0",
    "lucide-react": "^0.400.0",
    "next": "^16.3.6",
    "nuqs": "^2.0.0",
    "papaparse": "^5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.0.0",
    "react-hotkeys-hook": "^5.0.0",
    "server-only": "0.0.1",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.0",
    "@electric-sql/pglite": "0.3.16",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.6",
    "fake-indexeddb": "^6.2.4",
    "jsdom": "^27.0.0",
    "prettier": "^3.0.0",
    "react-server-dom-webpack": "19.3.0",
    "supabase": "^2.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vinext": "1.0.0",
    "vite": "^8.3.1",
    "vitest": "^3.0.0",
    "wrangler": "^4.145.0"
  },
  "engines": {
    "node": ">=22.0.0"
